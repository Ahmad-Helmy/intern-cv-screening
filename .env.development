# Loaded by Vite only in "development" mode, which is what
# `npm run start-with-mocks` runs. Turns on Mock Service Worker so the UI serves
# the built-in mock data instead of calling a backend. `npm run dev` runs in
# "live" mode and does NOT load this file.
VITE_USE_MOCKS=true
VITE_API_URL=http://localhost:5289

# Test user for mock mode — the mock POST /auth/login accepts only these.
# Not a real account: it exists solely inside src/mocks/handlers.ts, so every
# dev logs into the mock UI the same way.
VITE_MOCK_USER_EMAIL=demo@celfocus.com
VITE_MOCK_USER_PASSWORD=password
